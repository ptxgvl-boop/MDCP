local function AD_CheckHome()
    for i = 1, 5 do
        local plots = Workspace:FindFirstChild("Plots")
        local p = plots and plots:FindFirstChild("Plot" .. i)
        if p then
            local sign = p:FindFirstChild("PlotSign")
            local owners = sign and sign:FindFirstChild("ThisPlotsOwners")
            if owners then
                for _, v in pairs(owners:GetChildren()) do
                    if v.Value == LocalPlayer.Name then
                        local items = Workspace:FindFirstChild("PlotItems")
                        return items and items:FindFirstChild("Plot" .. i)
                    end
                end
            end
        end
    end
    return nil
end

local function AD_Spawn(toyName)
    local hrp = GetHRP(); if not hrp then return nil end
    local InPlot      = LocalPlayer:FindFirstChild("InPlot")
    local InOwnedPlot = LocalPlayer:FindFirstChild("InOwnedPlot")
    local CanSpawnToy = LocalPlayer:FindFirstChild("CanSpawnToy")

    if InPlot and InOwnedPlot and InPlot.Value and not InOwnedPlot.Value then
        InPlot:GetPropertyChangedSignal("Value"):Wait()
    end
    if CanSpawnToy and not CanSpawnToy.Value then
        CanSpawnToy:GetPropertyChangedSignal("Value"):Wait()
    end

    local SpawnCF = (State.AntiDecoyPCLD or hrp).CFrame * CFrame.new(0, 14, 20)
    local Container = (InOwnedPlot and InOwnedPlot.Value) and AD_CheckHome() or GetSpawnedToysFolder()
    if not Container then return nil end

    local spawned = nil
    local conn
    conn = Container.ChildAdded:Connect(function(c)
        if c.Name == toyName then spawned = c end
    end)
    task.spawn(function()
        pcall(function()
            SpawnRemote:InvokeServer(toyName, SpawnCF, Vector3.zero)
        end)
    end)
    local t0 = tick()
    repeat task.wait(0.05) until spawned or (tick() - t0) > 3
    if conn then pcall(function() conn:Disconnect() end) end
    return spawned
end

local function AD_CheckNetOwner(part)
    local po = part:FindFirstChild("PartOwner")
    return po and po.Value == LocalPlayer.Name
end

local function AD_Loop()
    while State.AntiDecoyActive do
        task.wait(0.05)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        local inPlot = LocalPlayer:FindFirstChild("InPlot")
        local inv = GetSpawnedToysFolder()
        if not (hrp and hum and inv) then continue end
        if hum.Health <= 0 then continue end
        if inPlot and inPlot.Value then continue end

        if not State.AntiDecoyPCLD and not State.AntiDecoyPCLDConn then
            AD_FindPCLD(hrp)
        end

        local item = inv:FindFirstChild("AntiDecoy")
        local hitbox = item and item:FindFirstChild("Hitbox")

        if not item or not hitbox then
            for _, v in pairs(inv:GetChildren()) do
                if v.Name == "AntiDecoy" then
                    pcall(function() DestroyToy:FireServer(v) end)
                end
            end
            item = AD_Spawn(State.AntiDecoyItem)
            if not item then continue end
            hitbox = item:WaitForChild("Hitbox", 1)
            if hitbox then
                pcall(function() SetNetworkOwner:FireServer(hitbox, hitbox.CFrame) end)
            end
            for _, v in pairs(item:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.Transparency = 0.8
                    v.Color = Color3.fromRGB(0, 255, 255)
                end
            end
            item.Name = "AntiDecoy"
        end

        if hitbox and not AD_CheckNetOwner(hitbox) then
            pcall(function() SetNetworkOwner:FireServer(hitbox, hitbox.CFrame) end)
        end

        local target = State.AntiDecoyPCLD or hrp:FindFirstChild("FirePlayerPart") or hrp
        if hitbox and target then
            hitbox.CFrame = target.CFrame
            hitbox.AssemblyLinearVelocity = Vector3.zero
            hitbox.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

