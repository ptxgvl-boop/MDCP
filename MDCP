-- ============================================================
local AutoSit_Active = false

local function AutoSit_GetBlob()
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not folder then return nil end
    return folder:FindFirstChild("CreatureBlobman")
end

local function AutoSit_SpawnBlob(hrp)
    if not hrp then return nil end
    local folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
    if not folder then
        task.wait(0.3)
        folder = Workspace:FindFirstChild(LocalPlayer.Name .. "SpawnedInToys")
        if not folder then return nil end
    end

    local blob = folder:FindFirstChild("CreatureBlobman")
    if blob then return blob end

    task.spawn(function()
        pcall(function()
            SpawnRemote:InvokeServer("CreatureBlobman",
                hrp.CFrame * CFrame.new(0, 5, 5), Vector3.zero)
        end)
    end)

    local t0 = tick()
    repeat
        task.wait(0.05)
        blob = folder:FindFirstChild("CreatureBlobman")
    until blob or (tick() - t0) > 3

    return blob
end

local function AutoSit_DoSit(hum, hrp, seat)
    if not (hum and hrp and seat) then return false end
    if hum.SeatPart then return true end

    hrp.CFrame = seat.CFrame + Vector3.new(0, 1.2, -1)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.05)

    pcall(function() seat:Sit(hum) end)
    return hum.SeatPart ~= nil
end

local function AutoSit_Loop()
    while AutoSit_Active do
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        if hum and hrp and hum.Health > 0 then
            if hum.SeatPart and hum.SeatPart.Parent
                and hum.SeatPart.Parent.Name == "CreatureBlobman" then
                task.wait(0.3)
                continue
            end

            local blob = AutoSit_GetBlob()
            if not blob then
                blob = AutoSit_SpawnBlob(hrp)
                if not blob then task.wait(0.3) continue end
                task.wait(0.2)
            end

            local seat = blob:FindFirstChildWhichIsA("VehicleSeat", true)
                or blob:FindFirstChildWhichIsA("Seat", true)

            if seat then
                AutoSit_DoSit(hum, hrp, seat)
            end
        end

        task.wait(0.2)
    end
end

local function AutoSit_Start()
    if AutoSit_Active then return end
    AutoSit_Active = true
    State.AutoSitBlobActive = true
    State.AutoSitBlobTask = task.spawn(AutoSit_Loop)
end

local function AutoSit_Stop()
    AutoSit_Active = false
    State.AutoSitBlobActive = false
    if State.AutoSitBlobTask then
        pcall(function() task.cancel(State.AutoSitBlobTask) end)
        State.AutoSitBlobTask = nil
    end
    task.spawn(function()
        for _ = 1, 3 do
            local inv = GetSpawnedToysFolder()
            if inv then
                local blob = inv:FindFirstChild("CreatureBlobman")
                if blob then pcall(function() DestroyToy:FireServer(blob) end) end
            end
            task.wait(0.1)
        end
    end)
end

