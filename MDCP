local function StartLineLag()
    if State.LineLagTask then pcall(function() task.cancel(State.LineLagTask) end) State.LineLagTask=nil end
    if not CreateGrabLine then CreateGrabLine = GrabEvents:WaitForChild("CreateGrabLine", 5) end
    if not CreateGrabLine then return end
    State.LineLagTask = task.spawn(function()
        while State.LineLagActive do
            local amount = 100 + (State.LineLagLevel - 1) * 100
            local spawnLoc = Workspace:FindFirstChild("SpawnLocation") or LocalPlayer.Character
            if spawnLoc then
                for _ = 1, amount do
                    pcall(function() CreateGrabLine:FireServer(spawnLoc, CFrame.new(0, 9e9, 0)) end)
                end
            end
            task.wait(1)
        end
    end)
end
local function StopLineLag()
    State.LineLagActive=false
    if State.LineLagTask then pcall(function() task.cancel(State.LineLagTask) end) State.LineLagTask=nil end
end
local function StartPacketLag()
    if State.PacketLagTask then pcall(function() task.cancel(State.PacketLagTask) end) State.PacketLagTask=nil end
    if not ExtendGrabLine then ExtendGrabLine = GrabEvents:WaitForChild("ExtendGrabLine", 5) end
    if not ExtendGrabLine then return end
    State.PacketLagTask = task.spawn(function()
        while State.PacketLagActive do
            task.wait(0.5)
            local size = State.PacketLagSize * 1000000
            pcall(function() ExtendGrabLine:FireServer(string.rep("A", size)) end)
        end
    end)
end
local function StopPacketLag()
    State.PacketLagActive=false
    if State.PacketLagTask then pcall(function() task.cancel(State.PacketLagTask) end) State.PacketLagTask=nil end
end

