local function AS_Stick(kunai)
    if not kunai or not kunai:FindFirstChild("StickyPart") then return end
    local hrp = GetHRP(); if not hrp then return end
    local sp = kunai:FindFirstChild("SoundPart")
    if sp then
        if not sp:FindFirstChild("PartOwner") or sp.PartOwner.Value ~= LocalPlayer.Name then
            pcall(function() SetNetworkOwner:FireServer(sp, sp.CFrame) end)
        end
    end
    local firePart = hrp:FindFirstChild("FirePlayerPart")
        or hrp:WaitForChild("FirePlayerPart", 5)
    if not firePart then return end
    pcall(function()
        StickyPartEvent:FireServer(kunai.StickyPart, firePart,
            CFrame.new(0,0,0) * CFrame.Angles(0, math.rad(90), math.rad(90)))
    end)
    for _, obj in pairs(kunai:GetChildren()) do
        if obj.Name == "Pyramid" then
            obj.CanTouch=false obj.CanCollide=false obj.CanQuery=false obj.Transparency=0
            if not obj:FindFirstChild("Highlight") then
                local hl = Instance.new("Highlight", obj)
                hl.FillColor = Color3.fromRGB(0,0,0)
            end
        elseif obj.Name == "Main" then
            obj.CanTouch=false obj.CanCollide=false obj.CanQuery=false obj.Transparency=0
            if not obj:FindFirstChild("Highlight") then
                local hl = Instance.new("Highlight", obj)
                hl.FillColor = Color3.fromRGB(255,255,255)
            end
        elseif obj:IsA("BasePart") then
            obj.CanTouch=false obj.CanCollide=false obj.CanQuery=false obj.Transparency=1
        end
    end
end

