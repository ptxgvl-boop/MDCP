local function DS_IsFriend(player)
    local ok, result = pcall(function()
        return LocalPlayer:IsFriendsWith(player.UserId)
    end)
    return ok and result
end

local function DS_IsWhitelisted(player)
    if player == LocalPlayer then return true end
    if State.DSWhitelistFriends and DS_IsFriend(player) then return true end
    if State.DSWhitelist[player.Name] then return true end
    return false
end

local function DS_GetWhitelistPlayerNames()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            table.insert(list, p.DisplayName .. " (" .. p.Name .. ")")
        end
    end
    if #list == 0 then table.insert(list, "No players") end
    table.sort(list)
    return list
end

local function DS_GetUsernameFromDisplay(display)
    if type(display) ~= "string" then return nil end
    local startPos = string.find(display, "%(")
    if startPos then
        return string.sub(display, startPos + 1, -2)
    end
    return nil
end

local function DS_GetAllPlayers()
    local list = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not DS_IsWhitelisted(p) then
            table.insert(list, p)
        end
    end
    return list
end

local function DS_SpamOwnership(hrp)
    if not SetNetworkOwner or not hrp then return end
    pcall(function() SetNetworkOwner:FireServer(hrp, hrp.CFrame) end)
end

local function DS_TeleportToPlayer(myHrp, targetHrp)
    if not myHrp or not targetHrp then return end
    pcall(function()
        myHrp.CFrame = targetHrp.CFrame * CFrame.new(0, 5, 5)
        myHrp.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function DS_DestroyLineOnPlayer(hrp)
    if not hrp then return end
    local createLine = CreateGrabLine
    local destroyLine = DestroyGrabLine
    if not createLine or not destroyLine then return end
    pcall(function()
        createLine:FireServer(hrp, CFrame.new(0, 1e9, 0))
        task.wait()
        destroyLine:FireServer(hrp)
    end)
end

local function DS_StartLineLag()
    if State.DSLineLagActive then return end
    State.DSLineLagActive = true
    State.DSLineLagThread = task.spawn(function()
        if not CreateGrabLine then return end
        while State.DSLineLagActive do
            local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
                or Workspace:FindFirstChild("Spawn")
                or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))
            if spawnLocation then
                local randomX = math.random(-1e9, 1e9)
                local randomZ = math.random(-1e9, 1e9)
                local directions = {
                    CFrame.new(randomX, 0, randomZ),
                    CFrame.new(-randomX, 0, -randomZ),
                    CFrame.new(randomX, 0, -randomZ),
                    CFrame.new(-randomX, 0, randomZ)
                }
                for _, pos in pairs(directions) do
                    CreateGrabLine:FireServer(spawnLocation, pos)
                end
            end
            task.wait()
        end
    end)
end

local function DS_StopLineLag()
    State.DSLineLagActive = false
    if State.DSLineLagThread then
        pcall(function() task.cancel(State.DSLineLagThread) end)
        State.DSLineLagThread = nil
    end
end

local function DS_Execute()
    task.spawn(function()
        local height = (State.DSHeight == "Heaven") and 1e9 or 35
        local radius = State.DSCustomRadius or 40
        DS_StartLineLag()
        task.wait(1)

        local players = DS_GetAllPlayers()
        if #players == 0 then
            DS_StopLineLag()
            return
        end

        local myChar = LocalPlayer.Character
        local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
        if not myHrp then DS_StopLineLag(); return end

        local playerData = {}
        for _, plr in ipairs(players) do
            local char = plr.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                table.insert(playerData, { player = plr, hrp = hrp })
            end
        end

        for _, data in ipairs(playerData) do
            DS_TeleportToPlayer(myHrp, data.hrp)
            task.wait(0.2)
            DS_SpamOwnership(data.hrp)
            task.wait()
        end

        local angleStep = (math.pi * 2) / #playerData
        for idx, data in ipairs(playerData) do
            local angle = (idx - 1) * angleStep
            local x = math.cos(angle) * radius
            local z = math.sin(angle) * radius

            pcall(function()
                data.hrp.CFrame = CFrame.new(x, height, z)
                data.hrp.AssemblyLinearVelocity = Vector3.zero
            end)

            local bp = Instance.new("BodyPosition")
            bp.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            bp.P = 40000000
            bp.Position = Vector3.new(x, height, z)
            bp.Parent = data.hrp
            task.delay(2, function() pcall(function() bp:Destroy() end) end)
            task.wait()
        end

        for i = 1, 8 do
            for _, data in ipairs(playerData) do
                DS_DestroyLineOnPlayer(data.hrp)
            end
            task.wait(0.3)
        end
    end)
end

