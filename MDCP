local function AJS_Break()
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    local safePos = CFrame.new(-272.219, -7.350, 475.011)
    for _, v in ipairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then
            State.AntiJointSnapCache[v] = v.Part0
            v.Part0 = nil
        end
    end
    root.CFrame = safePos
    local conn = RunService.RenderStepped:Connect(function()
        if root and root.Parent then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
    table.insert(State.AntiJointSnapConns, conn)
end

local function AJS_Restore()
    for _, c in ipairs(State.AntiJointSnapConns) do
        pcall(function() c:Disconnect() end)
