local function BH_ApplyToModel(model)
    if not model then return end
    local hole = model:FindFirstChild("Hole")
    if not hole then return end

    hole.Material = State.BHNeonGlow and Enum.Material.Neon or Enum.Material.Plastic

    if not State.BHRainbow then
        local ct = BHColorTable[State.BHColorMode]
        if ct then
            hole.Color = ct.hole
            local beam = hole:FindFirstChild("Attachment") and hole.Attachment:FindFirstChild("Beam")
            if beam then beam.Color = ct.beam end
            local gui = hole:FindFirstChild("BillboardGui")
            if gui then
                if gui:FindFirstChild("Large") then gui.Large.ImageColor3 = ct.gui end
                if gui:FindFirstChild("Small") then gui.Small.ImageColor3 = ct.gui end
            end
        end
    end

    local beam = hole:FindFirstChild("Attachment") and hole.Attachment:FindFirstChild("Beam")
    if beam then
        beam.Width0 = State.BHBeamWidth0
        beam.Width1 = State.BHBeamWidth1
        beam.Transparency = NumberSequence.new(State.BHBeamTransparency / 100)
    end

    local gui = hole:FindFirstChild("BillboardGui")
    if gui then
        gui.Size = UDim2.new(State.BHBillboardSize, 0, State.BHBillboardSize, 0)
        gui.Enabled = not State.BHHideBillboard
    end

    local drone  = hole:FindFirstChild("Drone")
    local scream = hole:FindFirstChild("Scream")
    if drone  then drone.Volume  = State.BHSilent and 0 or 1 end
    if scream then scream.Volume = State.BHSilent and 0 or 1 end
    if scream then
        local reverb = scream:FindFirstChildOfClass("ReverbSoundEffect")
        if reverb then reverb.Enabled = State.BHReverb end
    end

    if State.BHWhiteHole then
        hole.Color = Color3.fromRGB(255,255,255)
        hole.Material = Enum.Material.Neon
        if beam then beam.Color = ColorSequence.new(Color3.fromRGB(255,255,255)) end
        if gui then
            if gui:FindFirstChild("Large") then gui.Large.ImageColor3 = Color3.fromRGB(255,255,255) end
            if gui:FindFirstChild("Small") then gui.Small.ImageColor3 = Color3.fromRGB(255,255,255) end
        end
    end
end

local function BH_ApplyRealistic(model)
    if not model then return end
    local ok, realistic = pcall(function()
        return game:GetObjects("rbxassetid://16797584940")[1]
    end)
    if not ok or not realistic then return end
    local hole = model:FindFirstChild("Hole")
    if not hole then realistic:Destroy() return end

    for _, obj in pairs(realistic:GetDescendants()) do
        if obj:IsA("ParticleEmitter") or obj:IsA("Beam") or obj:IsA("Sound") or obj:IsA("Trail") then
            obj:Clone().Parent = hole
        end
        if obj:IsA("BillboardGui") then
            local cur = hole:FindFirstChild("BillboardGui")
            if cur then
                local ng = obj:Clone()
                ng.Parent = hole
                if cur:FindFirstChild("Large") and ng:FindFirstChild("Large") then
                    cur.Large.Image = ng.Large.Image
                end
                if cur:FindFirstChild("Small") and ng:FindFirstChild("Small") then
                    cur.Small.Image = ng.Small.Image
                end
                ng:Destroy()
            end
        end
    end
    realistic:Destroy()
end

local function BH_Refresh()
    local model = BH_FindModel()
    if not model then return end
    if State.BHRealistic then BH_ApplyRealistic(model) else BH_ApplyToModel(model) end
end

