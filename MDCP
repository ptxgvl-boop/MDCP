    local currentHRP = PB_getHRP()
    if not currentHRP then return end

    PB_Running = true
    PB_Task = task.spawn(function()
        for i = 1, 5 do
            if not PB_Running then break end

            local shur = nil
            local conn
            conn = inv.ChildAdded:Connect(function(child)
                if child.Name == "NinjaShuriken" then
                    shur = child
                    conn:Disconnect()
                end
            end)

            pcall(function()
                SpawnRemote:InvokeServer(
                    "NinjaShuriken",
                    currentHRP.CFrame * CFrame.new(5, 8, 20),
                    Vector3.new(0, 0, 0)
                )
            end)

            local startTime = tick()
            repeat
                if shur and shur:FindFirstChild("StickyPart") and shur:FindFirstChild("SoundPart") then
                    break
                end
                task.wait(0.01)
            until tick() - startTime > 0.5
            shur = shur or inv:FindFirstChild("NinjaShuriken")

            if shur then
                local soundPart = shur:FindFirstChild("SoundPart")
                local stickyPart = shur:FindFirstChild("StickyPart")
                if soundPart and stickyPart then
                    for _ = 1, 15 do
                        pcall(function() SetNetworkOwner:FireServer(soundPart, soundPart.CFrame) end)
                        if soundPart:FindFirstChild("PartOwner")
                            and soundPart.PartOwner.Value == LocalPlayer.Name then
                            break
                        end
