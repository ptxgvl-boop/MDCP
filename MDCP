                                StickyPartEvent:FireServer(
                                    stickyPart,
                                    plotArea,
                                    CFrame.new(1e12, 1e12, 1e12)
                                )
                            end)
                        end
                    end
                end
            end
            task.wait(0.1)
        end
        PB_Running = false
        PB_Task = nil
    end)
