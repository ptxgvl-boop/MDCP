    if State.RagdollSpawnMonitor then State.RagdollSpawnMonitor:Disconnect() State.RagdollSpawnMonitor=nil end
    task.spawn(function()
        for _ = 1, 3 do
            RK_DestroyPencils()
            task.wait(0.1)
        end
    end)
end

