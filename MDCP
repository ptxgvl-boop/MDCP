end

local function KA_GetAllPlayers()
    local allPlayers = {}
    local seenNames = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not KA_IsWhitelisted(player) then
            if not seenNames[player.Name] then
                table.insert(allPlayers, player)
                seenNames[player.Name] = true
            end
        end
    end

    local plotItems = Workspace:FindFirstChild("PlotItems")
    local playersInPlots = plotItems and plotItems:FindFirstChild("PlayersInPlots")
    if playersInPlots then
        for _, playerObj in ipairs(playersInPlots:GetChildren()) do
            local playerName = playerObj.Name
            local player = Players:FindFirstChild(playerName)
            if player and player ~= LocalPlayer and not KA_IsWhitelisted(player) then
                if not seenNames[playerName] then
                    table.insert(allPlayers, player)
                    seenNames[playerName] = true
                end
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj:FindFirstChild("HumanoidRootPart") then
            local playerName = obj.Name
            if not seenNames[playerName] then
                local player = Players:FindFirstChild(playerName)
                if player and player ~= LocalPlayer and not KA_IsWhitelisted(player) then
                    table.insert(allPlayers, player)
                    seenNames[playerName] = true
                end
            end
        end
    end

    return allPlayers
end

local function KA_GetPlayerHRP(player)
    if not player then return nil end
    local playerName = player.Name

    local char = player.Character
    if char and char.Parent then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and hrp.Parent then return hrp end
    end

    local plotItems = Workspace:FindFirstChild("PlotItems")
    if plotItems then
        for _, plot in ipairs(plotItems:GetChildren()) do
            local playersInPlot = plot:FindFirstChild("PlayersInPlots")
            if playersInPlot and playersInPlot:FindFirstChild(playerName) then
                for _, child in ipairs(plot:GetDescendants()) do
                    if child:IsA("Model") and child.Name == playerName then
                        local hrp = child:FindFirstChild("HumanoidRootPart")
                        if hrp then return hrp end
                    end
                end
            end
        end
    end

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and obj.Name == playerName then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            if hrp and hrp.Parent then return hrp end
        end
    end

    return nil
end

local function KA_GetMyRoot()
    return LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
end

local function KA_ResetTargets()
    for id, status in pairs(State.KAKickStatus) do
        if status == "Targeting" then
            State.KAKickStatus[id] = nil
        end
    end
end

local function KA_StartAutoLag(rate)
    if State.KALagConn then
        State.KALagConn:Disconnect()
        State.KALagConn = nil
    end

    State.KALagRunning = true
    State.KALagRate = rate or 120

    local frameRate = 60
    local basePerFrame = math.floor(State.KALagRate / frameRate)
    local remainder = State.KALagRate - (basePerFrame * frameRate)
    local frameCounter = 0

    State.KALagConn = RunService.Heartbeat:Connect(function()
        if not State.KALagRunning then return end
        frameCounter = frameCounter + 1
        local sendCount = basePerFrame
        if frameCounter <= remainder then
            sendCount = sendCount + 1
        end

        local spawnLocation = Workspace:FindFirstChild("SpawnLocation")
            or Workspace:FindFirstChild("Spawn")
            or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart"))

        if spawnLocation then
            for _ = 1, sendCount do
                pcall(function()
                    local randomX = math.random(-2147483647, 2147483647)
                    local randomZ = math.random(-2147483647, 2147483647)
                    if CreateGrabLine then
                        CreateGrabLine:FireServer(spawnLocation, CFrame.new(randomX, 0, randomZ))
                    end
                end)
            end
        end
    end)
end

local function KA_StopAutoLag()
    State.KALagRunning = false
    if State.KALagConn then
        State.KALagConn:Disconnect()
        State.KALagConn = nil
    end
end

local function KA_StopEverything()
    State.KAKickActive = false
    KA_StopAutoLag()
    KA_ResetTargets()

    if State.KACurrentBlob and State.KACurrentBlob.Parent then
        pcall(function() State.KACurrentBlob:Destroy() end)
        State.KACurrentBlob = nil
    end

    local myRoot = KA_GetMyRoot()
    if myRoot then
        pcall(function()
            myRoot.CFrame = CFrame.new(0, 5, 0)
            myRoot.AssemblyLinearVelocity = Vector3.zero
            myRoot.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local myChar = LocalPlayer.Character
    if myChar then
        local hum = myChar:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.PlatformStand = false
                hum.Sit = false
            end)
        end
        for _, part in ipairs(myChar:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = true
                    part.CanTouch = true
                end)
            end
        end
    end

    Library:Notify({Title = "All Stop", Description = "全部止めました", Time = 3})
end

local function KA_KickAll()
    if State.KAKickActive then return end
    State.KAKickActive = true

    if not State.KALagRunning then
        KA_StartAutoLag(State.KALagRate)
    end

    local allPlayers = KA_GetAllPlayers()
    if #allPlayers == 0 then
        Library:Notify({Title = "Kick All", Description = "対象がいません", Time = 3})
        State.KAKickActive = false
        return
    end

    for _, targetPlayer in ipairs(allPlayers) do
        State.KAKickStatus[targetPlayer.UserId] = "Targeting"
    end

    local rootPart = KA_GetMyRoot()
    if rootPart then
        local spawnPos = rootPart.CFrame * CFrame.new(0, 0, -3)
        pcall(function()
            SpawnRemote:InvokeServer("CreatureBlobman", spawnPos, Vector3.new(0, 127, 0))
        end)
    end
    task.wait(0.4)

    if not State.KAKickActive then return end

    local toyFolder = GetSpawnedToysFolder()
    State.KACurrentBlob = toyFolder and toyFolder:FindFirstChild("CreatureBlobman")
    if not State.KACurrentBlob then
        KA_ResetTargets()
        State.KAKickActive = false
        return
    end

    local vehicleSeat = State.KACurrentBlob:FindFirstChild("VehicleSeat")
    if vehicleSeat and LocalPlayer.Character then
        vehicleSeat:Sit(LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
    end
    task.wait(0.2)

    local myRoot = KA_GetMyRoot()
    if not myRoot then
        KA_ResetTargets()
        State.KAKickActive = false
        return
    end

    for _, targetPlayer in ipairs(allPlayers) do
        if not State.KAKickActive then break end
        local targetRoot = KA_GetPlayerHRP(targetPlayer)
        if targetRoot then
            for _ = 1, 2 do
                if not targetRoot.Parent then break end
                myRoot.CFrame = targetRoot.CFrame
                myRoot.AssemblyAngularVelocity = Vector3.zero
                task.wait(0.04)
            end

            for _ = 1, 5 do
                if not State.KAKickActive then break end
                if not targetRoot.Parent or not State.KACurrentBlob.Parent then break end
                pcall(function()
                    local scriptHolder = State.KACurrentBlob:FindFirstChild("BlobmanSeatAndOwnerScript")
                    if scriptHolder then
                        local grabRemote = scriptHolder:FindFirstChild("CreatureGrab")
                        local releaseRemote = scriptHolder:FindFirstChild("CreatureRelease")
                        if grabRemote then
                            task.spawn(function()
                                grabRemote:FireServer(State.KACurrentBlob.LeftDetector, targetRoot, State.KACurrentBlob.LeftDetector.LeftWeld)
                                grabRemote:FireServer(State.KACurrentBlob.RightDetector, targetRoot, State.KACurrentBlob.RightDetector.RightWeld)
                                if releaseRemote then
                                    releaseRemote:FireServer(State.KACurrentBlob.LeftDetector.LeftWeld)
                                    releaseRemote:FireServer(State.KACurrentBlob.RightDetector.RightWeld)
                                end
                            end)
                        end
                    end
                end)
                task.wait(0.003)
            end
        end
    end

    if not State.KAKickActive then return end

    local targetHeight = State.KAHeight
    myRoot.CFrame = CFrame.new(0, targetHeight, 0)
    myRoot.AssemblyLinearVelocity = Vector3.zero
    task.wait(0.05)

    for _, part in ipairs(State.KACurrentBlob:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() part.Anchored = true end) end
    end
    task.wait(0.05)

    local radius = State.KACircleRadius
    for i, targetPlayer in ipairs(allPlayers) do
        if not State.KAKickActive then break end
        local targetRoot = KA_GetPlayerHRP(targetPlayer)
        if targetRoot then
            local angle = math.rad((i - 1) * (360 / #allPlayers))
            local x = radius * math.cos(angle)
            local z = radius * math.sin(angle)
            pcall(function()
                targetRoot.CFrame = CFrame.new(x, targetHeight + 15, z)
                targetRoot.AssemblyLinearVelocity = Vector3.zero
            end)
        end
    end
    task.wait(0.1)

    if not State.KAKickActive then return end

    for _ = 1, 4 do
        if not State.KAKickActive then break end
        for _, targetPlayer in ipairs(allPlayers) do
            local targetRoot = KA_GetPlayerHRP(targetPlayer)
            if targetRoot then
                task.spawn(function()
                    pcall(function()
                        SetNetworkOwner:FireServer(targetRoot, CFrame.new(targetRoot.Position))
                        if DestroyGrabLine then
                            DestroyGrabLine:FireServer(targetRoot)
                        end
                    end)
                end)
            end
        end
        task.wait(0.015)
    end

    task.wait(0.1)

    if not State.KAKickActive then return end

    for _, targetPlayer in ipairs(allPlayers) do
        if not State.KAKickActive then break end
        local targetRoot = KA_GetPlayerHRP(targetPlayer)
        if targetRoot then
            task.spawn(function()
                pcall(function()
                    local scriptHolder = State.KACurrentBlob:FindFirstChild("BlobmanSeatAndOwnerScript")
                    if scriptHolder then
                        local grab = scriptHolder:FindFirstChild("CreatureGrab")
                        if grab then
                            grab:FireServer(State.KACurrentBlob.LeftDetector, targetRoot, State.KACurrentBlob.LeftDetector.LeftWeld)
                            grab:FireServer(State.KACurrentBlob.RightDetector, targetRoot, State.KACurrentBlob.RightDetector.RightWeld)
                        end
                    end
                end)
            end)
        end
    end

    task.wait(0.05)

    for _, targetPlayer in ipairs(allPlayers) do
        if targetPlayer and targetPlayer.Parent == Players then
            State.KAKickStatus[targetPlayer.UserId] = "Kicked"
        end
    end

    myRoot.CFrame = CFrame.new(0, -50000, 0)

    for _, part in ipairs(State.KACurrentBlob:GetDescendants()) do
        if part:IsA("BasePart") then pcall(function() part.Anchored = false end) end
    end

    task.wait(0.5)
    State.KAKickActive = false
end

